  "timeline": [
    {
      "year": 2002,
      "event": "Senior debut for Sporting CP vs Inter in the UEFA Champions League third qualifying round, 14 August 2002, aged 17; first senior goals two months later against Moreirense"
    },
    {
      "year": 2003,
      "event": "Signs for Manchester United for £12.24m on 16 August 2003 and takes the legendary No. 7 shirt; Portugal debut against Kazakhstan on 20 August 2003"
    },
    {
      "year": 2004,
      "event": "First Portugal goal, a header against Greece at Euro 2004; first Manchester United goal, a free kick against Portsmouth; wins the FA Cup as the youngest player to score in an FA Cup final"
    },
    {
      "year": 2006,
      "event": "Scores at the 2006 FIFA World Cup against Iran; wins the Football League Cup and reaches the UEFA Cup final with Manchester United"
    },
    {
      "year": 2007,
      "event": "First Manchester United hat-trick against Newcastle in January; Premier League title in his first full season; 50th United goal in the Manchester derby"
    },
    {
      "year": 2008,
      "event": "Ballon d'Or at 23, named on all 96 ballots; FIFA World Player of the Year; the UEFA Champions League and the FIFA Club World Cup; eight goals and the Golden Ball at the 2008 FIFA World Cup"
    },
    {
      "year": 2009,
      "event": "FIFA Puskás Award for a 40-yard strike against Porto; joins Real Madrid for a then world-record €94m, with 80,000 in the Bernabéu"
    },
    {
      "year": 2011,
      "event": "First Spanish trophy, the Copa del Rey final header against Barcelona; La Liga title with a record 100 points and 46 league goals"
    },
    {
      "year": 2012,
      "event": "100th La Liga goal for Real Madrid; 60 goals in a calendar year across club and country"
    },
    {
      "year": 2013,
      "event": "First international hat-trick, three goals in 15 minutes against Northern Ireland; second Ballon d'Or"
    },
    {
      "year": 2014,
      "event": "La Décima: a last-gasp extra-time penalty against Atlético in Lisbon, a record 17 Champions League goals, UEFA Men's Player of the Year and a third Ballon d'Or"
    },
    {
      "year": 2015,
      "event": "Five goals against Granada in an 8-minute hat-trick; becomes the all-time Champions League top scorer; the 500th goal of his career against Malmö"
    },
    {
      "year": 2016,
      "event": "EURO 2016 champion as captain, with three goals and the Silver Boot; a fourth Ballon d'Or"
    },
    {
      "year": 2017,
      "record": true,
      "event": "100th Champions League goal, a hat-trick against Bayern; passes Jimmy Greaves as the top scorer in Europe's big five leagues; the fourth Champions League and a fifth Ballon d'Or"
    },
    {
      "year": 2018,
      "event": "Signs for Juventus at 33; hat-tricks in the first Champions League game and against Real Madrid in the World Cup"
    },
    {
      "year": 2019,
      "event": "UEFA Nations League champion and the top scorer at the Finals; the 700th goal of his career against Ukraine"
    },
    {
      "year": 2020,
      "event": "1,000th senior appearance for Juventus against Cagliari; the 100th and 101st goals for Portugal against Sweden"
    },
    {
      "year": 2021,
      "event": "Passes Ali Daei to become the outright leading scorer in men's international football; the 10th international hat-trick, a world record"
    },
    {
      "year": 2022,
      "event": "Passes Josef Bican with a hat-trick against Tottenham; the World Cup in Qatar ends with Portugal knocked out by Morocco"
    },
    {
      "year": 2023,
      "event": "Al Nassr debut as captain against Al-Ettifaq; the 197th cap makes him the most-capped player in men's international football"
    },
    {
      "year": 2024,
      "event": "900th career goal against Croatia in the Nations League; the first player to score 40 or more goals in 13 different calendar years"
    },
    {
      "year": 2025,
      "event": "The 800th club goal against Al Fateh; the 100th Al Nassr goal makes him the first to reach 100 goals for four clubs; a second Nations League title at 40"
    },
    {
      "year": 2026,
      "event": "Saudi Pro League title with Al Nassr; the 500th goal scored after turning 30; becomes the first man to score at six FIFA World Cups"
    }
  ],
